// hardware/interfaces/automotive is dropped from the framework-only tree; consumer is the
// vendor cc_test DefaultBroadcastRadioHalTestCase (header_libs). Upstream def lives in
// automotive/vehicle/aidl/impl/hardware/Android.bp (cc_library_headers, vendor: true).
cc_library_headers {
    name: "IVehicleHardware",
    vendor: true,
}

// frameworks/rs is dropped from the framework-only tree; consumer is
// android.hardware.renderscript@1.0-impl (runtime_libs).
cc_library_shared {
    name: "libRS_internal",
    vendor_available: true,
}

cc_library_shared {
    name: "libRSDriver",
    vendor_available: true,
}

// External codec sources (dav1d, libgav1, libhevc, libavc, libmpeg2, libgsm, libogg) are not in the
// framework-only tree and have no extractive shadows yet (not in the ag registry); consumers
// are libcodec2_soft_* / libstagefright codecs / goldfish C2 / voip JNI (all static_libs).
cc_library_static {
    name: "libdav1d",
    vendor_available: true,
    product_available: true,
    recovery_available: true,
    host_supported: true,
}

cc_library_static {
    name: "libgav1",
    vendor_available: true,
    product_available: true,
    recovery_available: true,
    host_supported: true,
}

cc_library_static {
    name: "libhevcdec",
    vendor_available: true,
    product_available: true,
    recovery_available: true,
    host_supported: true,
}

cc_library_static {
    name: "libhevcenc",
    vendor_available: true,
    product_available: true,
    recovery_available: true,
    host_supported: true,
}

cc_library_static {
    name: "libavcdec",
    vendor_available: true,
    product_available: true,
    recovery_available: true,
    host_supported: true,
}

cc_library_static {
    name: "libavcenc",
    vendor_available: true,
    product_available: true,
    recovery_available: true,
    host_supported: true,
}

cc_library_static {
    name: "libmpeg2dec",
    vendor_available: true,
    product_available: true,
    recovery_available: true,
    host_supported: true,
}

cc_library_static {
    name: "libgsm",
    vendor_available: true,
    product_available: true,
    recovery_available: true,
    host_supported: true,
