    name: "libXNNPACK",
    vendor_available: true,
    product_available: true,
    recovery_available: true,
    host_supported: true,
}

cc_library_static {
    name: "libpthreadpool",
    vendor_available: true,
    product_available: true,
    recovery_available: true,
    host_supported: true,
}

// external/giflib is dropped from the framework-only tree (no shadow, not in the registry); consumers:
// libhwui + hwui_unit_tests + libandroid_runtime (static_libs, android target only). Mirrors upstream
// (sdk_version "9", vendor_available); GIFMovie.cpp includes gif_lib.h at compile time — resolution
// stub only (real header/sources absent).
cc_library_static {
    name: "libgif",
    sdk_version: "9",
    vendor_available: true,
}

// system/memory/libmemtrack (standalone googlesource repo) is dropped from the framework-only tree;
// consumer: libandroid_runtime (shared_libs). VNDK v30-v34 prebuilts exist but are vndk_prebuilt_shared
// (VNDK ABI contexts only). Mirrors upstream (cc_library_shared, vendor_available).
cc_library_shared {
    name: "libmemtrack",
    vendor_available: true,
}

