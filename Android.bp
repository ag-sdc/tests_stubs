// -----------------------------------------------------------------------------
// ART module_exports + MTS test-support stubs
// consumers: art/build/sdk art-module-test-exports (java_libs/java_tests),
// libnativehelper/tests_mts + packages/modules/Permission MTS tests
// -----------------------------------------------------------------------------
java_library {
    name: "nativetesthelper",
    host_supported: true,
}

java_library {
    name: "okhttp-nojarjar",
    host_supported: true,
}

java_library {
    name: "okhttp-tests-nojarjar",
    host_supported: true,
}

java_library {
    name: "okhttp-for-host",
    host_supported: true,
}

java_test {
    name: "apache-harmony-tests",
    host_supported: true,
}

java_test {
    name: "apache-harmony-jdwp-tests",
    host_supported: true,
}

// ActivityContext is defined in the cts repo (common/device-side/bedstead/activitycontext);
// the framework-only tree drops cts. Consumers are test-only (FrameworksServicesTests,
// PackageManagerServiceServerTests), so an empty stub resolves the build graph.
android_library {
    name: "ActivityContext",
}

// android.car is defined in packages/services/Car (dropped from the framework-only tree);
// consumer is test-only (PermissionControllerMockingTests). sdk_version mirrors upstream android.car-defaults.
java_library {
    name: "android.car",
    sdk_version: "module_current",
}

// android.hardware.automotive.evs@common-default-lib is defined in
// hardware/interfaces/automotive/evs/common/utils/default (dropped from the framework-only tree);
// consumer is test-only (VtsHalAutomotiveDisplayV1_0TargetTest).
cc_library_static {
    name: "android.hardware.automotive.evs@common-default-lib",
}

// external/libnos is not in the framework-only tree; consumer is the Pixel fastboot impl
// (hardware/google/pixel/fastboot, recovery: true). x86_64-GSI-irrelevant; stub resolves analysis.
cc_library_static {
    name: "libnos_for_fastboot",
    recovery_available: true,
    vendor_available: true,
}

cc_library_static {
    name: "libnos_citadel_for_fastboot",
    recovery_available: true,
    vendor_available: true,
}
